[Unit]
Description=INAS Device Hub Service for %I
Wants=network-online.target mosquitto.service
After=network-online.target mosquitto.service

[Service]
Type=simple
WorkingDirectory=@@INAS_HUB_DIR@@
ExecStart=@@INAS_HUB_DIR@@/serve.sh %I
Environment=PYTHONUNBUFFERED=1
User=@@INAS_HUB_USER@@
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
