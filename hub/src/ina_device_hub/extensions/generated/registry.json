{
  "extension_api_version": 1,
  "extensions": {
    "jp.inas.development.operation-check": {
      "compatibility": {
        "hub_extension_api": 1
      },
      "description": "Hub Extensionの概要カード、追加タブ、現在値の参照が正しく動くことを確認するための開発用プラグインです。",
      "id": "jp.inas.development.operation-check",
      "name": "Extension 動作確認プラグイン",
      "schema_version": 1,
      "source": "extensions/operation-check",
      "ui": {
        "device_detail": {
          "device_kinds": [
            "WTR"
          ],
          "overview_cards": [
            {
              "description": "このカードが表示されていれば、WTR向けの概要拡張をHubが安全に読み込めています。",
              "id": "extension-ready",
              "title": "プラグインが動作しています",
              "tone": "sun",
              "type": "callout"
            }
          ],
          "tabs": [
            {
              "blocks": [
                {
                  "items": [
                    {
                      "description": "Hubが許可された項目だけで構成されているか確認します。",
                      "title": "定義を検証"
                    },
                    {
                      "description": "WTRの機器詳細だけに概要カードとタブを追加します。",
                      "title": "対応機器へ追加"
                    },
                    {
                      "description": "機器データをHub側で安全に読み取り、文字として表示します。",
                      "title": "現在値を表示"
                    }
                  ],
                  "title": "読み込み確認",
                  "type": "process_flow"
                },
                {
                  "items": [
                    {
                      "label": "機器の表示名",
                      "value": {
                        "path": "name",
                        "source": "device"
                      }
                    },
                    {
                      "label": "現在の土壌水分",
                      "value": {
                        "path": "last_soil_moisture",
                        "source": "status",
                        "unit": "%"
                      }
                    },
                    {
                      "label": "水やり状態",
                      "value": {
                        "path": "watering_started",
                        "source": "status"
                      }
                    },
                    {
                      "label": "水やり開始の目安",
                      "value": {
                        "path": "moisture_threshold",
                        "source": "config",
                        "unit": "%"
                      }
                    }
                  ],
                  "title": "Hubから受け取った値",
                  "type": "metric_grid"
                },
                {
                  "description": "このプラグインは表示確認だけを行います。機器の設定変更や水やり操作は実行しません。",
                  "title": "動作確認用です",
                  "tone": "neutral",
                  "type": "callout"
                }
              ],
              "description": "宣言ファイルから追加された画面と、Hubが解決した現在値を確認します。",
              "id": "operation-check",
              "label": "拡張確認",
              "title": "Extensionの動作確認"
            }
          ]
        }
      },
      "version": "1.0.0"
    },
    "jp.inas.device.fgt-operation-guide": {
      "compatibility": {
        "hub_extension_api": 1
      },
      "description": "FGTの時間指定運転と、現在のポンプ設定を機器詳細に追加します。",
      "id": "jp.inas.device.fgt-operation-guide",
      "name": "FGT 時間指定運転ガイド",
      "schema_version": 1,
      "source": "extensions/fgt-operation-guide",
      "ui": {
        "device_detail": {
          "device_kinds": [
            "FGT"
          ],
          "overview_cards": [
            {
              "description": "各出力にON時間、OFF時間、繰り返し回数を設定します。設定した出力は順番に動きます。",
              "id": "mixing-cycle",
              "title": "ポンプを秒数で運転できます",
              "tone": "leaf",
              "type": "callout"
            }
          ],
          "tabs": [
            {
              "blocks": [
                {
                  "items": [
                    {
                      "description": "時刻同期と最新設定を確認して運転を始めます。",
                      "title": "予約時刻に起動"
                    },
                    {
                      "description": "ON時間が0秒の出力は動かしません。",
                      "title": "設定した出力をON"
                    },
                    {
                      "description": "OFF時間を待ってから次の運転へ進みます。",
                      "title": "必要なら一時停止"
                    },
                    {
                      "description": "ONとOFFを設定した回数だけ繰り返します。",
                      "title": "指定回数を繰り返す"
                    },
                    {
                      "description": "完了後と異常時はすべての出力を停止します。",
                      "title": "すべてOFFで終了"
                    }
                  ],
                  "title": "運転の流れ",
                  "type": "process_flow"
                },
                {
                  "items": [
                    {
                      "label": "ON時間",
                      "value": {
                        "path": "fgt.timed_outputs.nutrient_a.on_sec",
                        "source": "config",
                        "unit": "秒"
                      }
                    },
                    {
                      "label": "OFF時間",
                      "value": {
                        "path": "fgt.timed_outputs.nutrient_a.off_sec",
                        "source": "config",
                        "unit": "秒"
                      }
                    },
                    {
                      "label": "繰り返し",
                      "value": {
                        "path": "fgt.timed_outputs.nutrient_a.repeat_count",
                        "source": "config",
                        "unit": "回"
                      }
                    },
                    {
                      "label": "通常の起床間隔",
                      "value": {
                        "path": "sleep_sec",
                        "source": "config",
                        "unit": "秒"
                      }
                    }
                  ],
                  "title": "現在のA液ポンプ設定",
                  "type": "metric_grid"
                },
                {
                  "description": "複数の出力は同時に動かさず、I/O異常、漏水、非常停止、運転時間超過を検出するとすべてOFFにします。",
                  "title": "異常時はすべて停止します",
                  "tone": "water",
                  "type": "callout"
                }
              ],
              "description": "各出力の動きと、現在設定されている秒数をまとめて確認できます。",
              "id": "fertigation-flow",
              "label": "時間指定運転",
              "title": "予約時刻のポンプ運転"
            }
          ]
        }
      },
      "version": "1.1.0"
    }
  },
  "schema_version": 1
}
