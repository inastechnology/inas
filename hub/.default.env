LANGUAGE=en
WORK_DIR=~/.ina-device-hub
LOCAL_STORAGE_BASE_DIR=/mnt/...
HUB_HTTP_HOST=0.0.0.0
HUB_HTTP_PORT=39151

TURSO_DATABASE_URL=libsql://
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL=600

S3_ENDPOINT_URL=https://
S3_BUCKET_NAME=
S3_BUCKET_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

S3_TMP_ENDPOINT_URL=https://***.r2.cloudflarestorage.com
S3_TMP_BUCKET_NAME=
S3_TMP_BUCKET_REGION=auto
S3_TMP_ACCESS_KEY=
S3_TMP_SECRET_KEY=
S3_TMP_BASE_URL=https://{your_temporary_storage_domain}

# OTA firmware binaries are served by this hub over HTTP.
# Default offer URL: http://<FIRMWARE_HOSTNAME or HOSTNAME>:<FIRMWARE_PORT or HUB_HTTP_PORT>
FIRMWARE_HOSTNAME=
FIRMWARE_PORT=39151
# Optional explicit override. Example: http://<hubのドメイン名またはIPアドレス>:39151
FIRMWARE_BASE_URL=

INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

INSTAGRAM_SENSOR_ID=
INSTAGRAM_CAMERA_ID=
INSTAGRAM_PLANT_POSITION_PROMPT="From left: blueberry, lychee"
INSTAGRAM_ADMIN_USERNAME=inas_technologies.ja

WEATHER_RECORD_ENABLED=true
WEATHER_RECORD_INTERVAL_SECONDS=21600
WEATHER_PROVIDER=open_meteo
WEATHER_LATITUDE=33.90366750991095
WEATHER_LONGITUDE=133.1918432786152
WEATHER_TIMEZONE=Asia/Tokyo
WEATHER_BACKFILL_DAYS=7
WEATHER_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_FORECAST_URL=https://www.data.jma.go.jp/developer/xml/feed/regular.xml
WEATHER_AREA_NAME=東予
WEATHER_OFFICE_NAME=松山地方気象台
WEATHER_FORECAST_TITLE=府県天気予報
INSTAGRAM_WEATHER_FORECAST_URL=https://www.data.jma.go.jp/developer/xml/feed/regular.xml
INSTAGRAM_WEATHER_AREA_NAME=東予
INSTAGRAM_WEATHER_OFFICE_NAME=松山地方気象台
INSTAGRAM_WEATHER_FORECAST_TITLE=府県天気予報

MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=

SWITCHBOT_OPEN_TOKEN=
SWITCHBOT_SECRET_KEY=
SWITCHBOT_PLUG_MINI_DEVICE_ID=
SWITCHBOT_BASE_URL=https://api.switch-bot.com
SWITCHBOT_TIMEOUT_SECONDS=20

DEVICE_CONFIG_DEFAULT_NTP_SERVER=pool.ntp.org
DEVICE_CONFIG_DEFAULT_TIMEZONE_OFFSET_SEC=32400
DEVICE_CONFIG_DEFAULT_MOISTURE_THRESHOLD=35

SENSOR_SAVE_IMAGE=false
SENSOR_SAVE_AUDIO=false

TIMELAPSE_INTERVAL=600

# ================================================
# AI settings
# ================================================
AI_ENABLED=true
AI_AGENT_SCHEDULE_START=09:01
AI_IMAGE_ANALYZE_API_KEY=sk-****
# AI_IMAGE_ANALYZE_BASE_URL=
AI_IMAGE_ANALYZE_MODEL=gpt-4o
AI_TEXT_ANALYZE_API_KEY=sk-***
AI_TEXT_ANALYZE_BASE_URL=https://api.deepseek.com
AI_TEXT_ANALYZE_MODEL=deepseek-reasoner


DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url
DISCORD_NOTIFY_MQTT_ACTIVITY=true
DISCORD_NOTIFY_NEW_DEVICE=true
DISCORD_NOTIFY_DEVICE_OFFLINE=true
DISCORD_NOTIFY_WATERING_MISSING=true

HEALTH_MONITOR_ENABLED=false
HEALTH_MONITOR_INTERVAL_SECONDS=1800
HEALTH_DEVICE_OFFLINE_AFTER_HOURS=12
HEALTH_WATERING_MISSING_AFTER_DAYS=2

# ================================================
# Cloudflare hosted option
# ================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_API_TOKEN=
CLOUDFLARE_HOSTED_PUBLIC_HOSTNAME=hub.example.com

CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_POLICY_AUD=
CLOUDFLARE_ACCESS_GROUP_ID=
CLOUDFLARE_ACCESS_APP_ID=
CLOUDFLARE_ACCESS_POLICY_ID=
CLOUDFLARE_ACCESS_APP_NAME=inas-hub-hosted
CLOUDFLARE_ACCESS_GROUP_NAME=inas-hub-allowed-users
CLOUDFLARE_ACCESS_POLICY_NAME=inas-hub-allow-email-group
CLOUDFLARE_ACCESS_SESSION_DURATION=4h
CLOUDFLARE_ACCESS_ALLOWED_EMAILS=
CLOUDFLARE_ACCESS_ALLOWED_EMAIL_DOMAINS=

CLOUDFLARE_TUNNEL_NAME=inas-hub
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_HOSTNAME=hub.example.com
CLOUDFLARE_TUNNEL_ORIGIN_URL=http://localhost:39151
CLOUDFLARE_TUNNEL_TOKEN_FILE=
CLOUDFLARE_TUNNEL_DNS_RECORD_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_CLOUDFLARED_BIN=
CLOUDFLARE_HOSTED_HUB_STARTUP_WAIT_SECONDS=3
