{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ina-device-hub-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ai_search": [
    {
      "binding": "SYSTEM_HELP_SEARCH",
      "instance_name": "inas-system-help",
      "remote": true
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "",
    "CLOUDFLARE_ACCESS_POLICY_AUD": "",
    "TURSO_DATABASE_URL": ""
  }
}
