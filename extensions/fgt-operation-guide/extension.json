{
  "schema_version": 1,
  "id": "jp.inas.device.fgt-operation-guide",
  "name": "FGT 時間指定運転ガイド",
  "version": "1.2.0",
  "description": "FGTの時間指定運転と、現在のポンプ設定を機器詳細に追加します。",
  "compatibility": {
    "hub_extension_api": 1
  },
  "ui": {
    "device_detail": {
      "device_kinds": [
        "FGT"
      ],
      "overview_cards": [
        {
          "id": "mixing-cycle",
          "title": "ポンプを秒数で運転できます",
          "description": "使用するポンプを選び、ON時間、OFF時間、繰り返し回数を設定します。有効なポンプは順番に動きます。",
          "type": "callout",
          "tone": "leaf"
        }
      ],
      "tabs": [
        {
          "id": "fertigation-flow",
          "label": "時間指定運転",
          "title": "予約時刻のポンプ運転",
          "description": "各出力の動きと、現在設定されている秒数をまとめて確認できます。",
          "blocks": [
            {
              "type": "process_flow",
              "title": "運転の流れ",
              "items": [
                {
                  "title": "予約時刻に起動",
                  "description": "時刻同期と最新設定を確認して運転を始めます。"
                },
                {
                  "title": "有効なポンプをON",
                  "description": "使用しないポンプは繰り返し0回として動かしません。"
                },
                {
                  "title": "必要なら一時停止",
                  "description": "OFF時間を待ってから次の運転へ進みます。"
                },
                {
                  "title": "指定回数を繰り返す",
                  "description": "ONとOFFを1〜99回の範囲で設定した回数だけ繰り返します。"
                },
                {
                  "title": "すべてOFFで終了",
                  "description": "完了後と異常時はすべての出力を停止します。"
                }
              ]
            },
            {
              "type": "metric_grid",
              "title": "現在のA液ポンプ設定",
              "items": [
                {
                  "label": "ON時間",
                  "value": {
                    "source": "config",
                    "path": "fgt.timed_outputs.nutrient_a.on_sec",
                    "unit": "秒"
                  }
                },
                {
                  "label": "OFF時間",
                  "value": {
                    "source": "config",
                    "path": "fgt.timed_outputs.nutrient_a.off_sec",
                    "unit": "秒"
                  }
                },
                {
                  "label": "繰り返し",
                  "value": {
                    "source": "config",
                    "path": "fgt.timed_outputs.nutrient_a.repeat_count",
                    "unit": "回"
                  }
                },
                {
                  "label": "通常の起床間隔",
                  "value": {
                    "source": "config",
                    "path": "sleep_sec",
                    "unit": "秒"
                  }
                }
              ]
            },
            {
              "type": "callout",
              "title": "異常時はすべて停止します",
              "description": "複数の出力は同時に動かさず、I/O異常、漏水、非常停止、運転時間超過を検出するとすべてOFFにします。",
              "tone": "water"
            }
          ]
        }
      ]
    }
  }
}
