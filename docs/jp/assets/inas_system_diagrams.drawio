<mxCell id="soi" value="SOI&lt;br&gt;畝 / 測点&lt;br&gt;土壌水分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="310" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="wtr" value="WTR/WRS&lt;br&gt;区画 / 畝&lt;br&gt;灌水実行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="500" width="240" height="120" as="geometry"/></mxCell>
