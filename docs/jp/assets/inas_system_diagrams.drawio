<mxCell id="ridge" value="畝 / ベッド&lt;br&gt;水分・灌水対象の単位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="270" width="260" height="110" as="geometry"/></mxCell>
