<mxCell id="system_architecture_note" value="- Cloudflare Workers は local hub 全機能の置換ではなく、Turso を境界にした管理 API/UI から始める。&lt;br&gt;- Tunnel はデバイス側で起動し、local hub を Cloudflare Access 越しに公開する。&lt;br&gt;- OTA firmware 本体は MQTT では送らず、local hub の HTTP endpoint から配信する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#334155;fontSize=17;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="70" y="870" width="1460" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="data_control_flow" name="Data and Control Flow"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="data_control_flow_title" value="観測から制御までの流れ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="700" height="60" as="geometry"/></mxCell>
<mxCell id="wake" value="1. 起床&lt;br&gt;センサー取得" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="status" value="2. MQTT status&lt;br&gt;測定値・起動履歴" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="210" height="110" as="geometry"/></mxCell>
<mxCell id="normalize" value="3. hub 正規化&lt;br&gt;sensor_measurements&lt;br&gt;イベント保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="150" width="230" height="130" as="geometry"/></mxCell>
<mxCell id="ui" value="4. UI 表示&lt;br&gt;グラフ・カード&lt;br&gt;履歴" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="110" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="field" value="5. 圃場前提&lt;br&gt;作物・品種&lt;br&gt;目標レンジ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="290" width="230" height="130" as="geometry"/></mxCell>
<mxCell id="candidate" value="6. 判断候補&lt;br&gt;灌水・液肥・噴霧&lt;br&gt;現状は灌水のみ実行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="approval" value="7. 承認 / 記録&lt;br&gt;action_plans&lt;br&gt;人間評価" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="470" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="command" value="8. device config&lt;br&gt;または灌水指示&lt;br&gt;MQTT publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="550" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="actuate" value="9. 実行&lt;br&gt;WTR/WRS ポンプ&lt;br&gt;バルブ制御" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="540" width="230" height="130" as="geometry"/></mxCell>
<mxCell id="feedback" value="10. 結果観測&lt;br&gt;次回起床で評価" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;arcSize=8;fontColor=#0f172a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="510" width="230" height="110" as="geometry"/></mxCell>
