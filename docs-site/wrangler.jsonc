{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inas-documentation",
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docs.inas-technologies.com",
      "custom_domain": true
    }
  ]
}
