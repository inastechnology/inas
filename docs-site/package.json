{
  "name": "inas-documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-content.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run check && npx --yes wrangler@4.112.0 deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.3",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.9.3"
  }
}
